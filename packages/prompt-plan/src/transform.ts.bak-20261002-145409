/**
 * Declarative shape-preserving transforms: what a rule does to the text a
 * section carries WITHOUT replacing it.
 *
 * WHY THIS EXISTS. A section whose `text` is a FUNCTION is generated per
 * assembly, per scope: `tools:sdk` renders the tool set the calling agent can
 * actually see, `tool:read` disappears for an agent with no `read` tool, and so
 * on. A constant `replace` throws that away: every agent gets one frozen copy of
 * the text, which is worse than useless — the SDK then advertises tool names
 * that agent cannot call. A transform keeps the per-scope difference and only
 * removes or selects the parts a rule names.
 *
 * PURITY IS THE CONTRACT, and it is a measured one rather than a stylistic one:
 * the assembled system prompt is the prefix of every request, and a KV-cache
 * prefix is reused only while the bytes are unchanged. A transform that varies
 * with wall-clock time, iteration order of a Set, or a locale would silently
 * destroy that reuse. Every operation here is therefore a pure function of its
 * input text and the rule's own literals: same text in, same text out, in any
 * process, in any order.
 *
 * The operations are a CLOSED, DECLARATIVE SET on purpose. A rule file is
 * authored by hand and read by an operator; a rule that can run arbitrary code
 * cannot be reviewed by reading it, and this package's whole posture is that a
 * hand-edited file gets a sentence naming the problem, not a silently different
 * prompt. When the set is not enough, the answer is a new named operation here,
 * with its own tests, not an escape hatch.
 *
 * @module @t4r71/dsh-prompt-plan/transform
 */

import { stripToolDeclarations, stripDeclarationComments } from './strip.ts'
import type { DocStripReport } from './strip.ts'

/**
 * Drop every line matching a regular expression.
 *
 * For example `pattern: ^\s*\*\s` on generated TypeScript removes the JSDoc
 * description lines above each declaration while leaving the declarations
 * themselves — and because the declarations differ per scope, so does the
 * result.
 */
export interface DropLinesOp {
  readonly op: 'dropLines'
  /** The pattern, as written in the rule file, compiled once. */
  readonly pattern: RegExp
  /** The pattern's source, kept for diagnostics. */
  readonly source: string
  /**
   * Whether a line that becomes empty after dropping is left as an empty line or
   * removed entirely. Default `true` (leave it), so line numbering is stable and
   * a rule cannot silently reflow a block.
   */
  readonly blank?: boolean
}

/**
 * Keep only the lines matching a regular expression, plus at most one blank line
 * where a run of them was.
 *
 * A line filter for prose-shaped section text. Blank runs collapse to one blank
 * line rather than vanishing, so a kept list still looks like a list.
 */
export interface KeepLinesOp {
  readonly op: 'keepLines'
  readonly pattern: RegExp
  readonly source: string
}

/**
 * Keep or drop whole blocks of lines, each block identified by its HEADER line —
 * the line matching `headerPattern`.
 *
 * HOW A BLOCK IS FOUND, stated exactly because there is no ambiguity allowed in
 * a rewrite: the block header is the line that matches `headerPattern`; the
 * block's body is every following line up to (not including) the next line that
 * matches `headerPattern`. Text before the first header is never part of a block
 * and is always kept — that is the shared preamble every generated SDK block has,
 * and dropping it would break the text for every scope at once.
 *
 * A block is KEPT when its header matches `keepPattern`; `denyPattern` then
 * removes a block that would otherwise be kept (deny wins). With the generated
 * TypeScript SDK — `  name: ReturnType;` for every visible tool — a rule that
 * keeps three names produces a text that still contains exactly those three,
 * in the scope's own order.
 */
export interface KeepBlocksOp {
  readonly op: 'keepBlocks'
  readonly headerPattern: RegExp
  readonly keepPattern: RegExp
  readonly denyPattern?: RegExp
  readonly headerSource: string
  readonly keepSource: string
  readonly denySource?: string
}

/**
 * Remove whole tool DECLARATIONS from the generated SDK text, leaving the tools
 * callable.
 *
 * What it removes is the tool's two members — one in \`ToolArgsMap\`, one in
 * \`ToolOutputMap\` — together with the doc lines above the args member, which is
 * where the tool's description lives. That is the whole of a tool's prompt cost.
 *
 * What it must never do is touch VISIBILITY. The sandbox binding comes from
 * \`registry.schemas(exec.agent)\`, not from this text, so a text-only removal
 * keeps \`await tools.<name>(args)\` working; a visibility rule (disable, deny,
 * \`tools.restrict\`) removes the binding as well and yields
 * \`TypeError: tools.<name> is not a function\`. This op rewrites text and nothing
 * else.
 *
 * Every removal is verified: the characters removed must equal the sum of the
 * per-tool declaration lengths measured first, the remainder must still
 * brace-balance, and each map must still carry the members it had minus the ones
 * removed. Any failure returns the text UNCHANGED, and so does any exception —
 * the system prompt must assemble even when this op is broken.
 */
export interface StripToolDeclsOp {
  readonly op: 'stripToolDecls'
  /**
   * The tool names this RULE always strips, whatever else is in force. Empty means
   * "the rule itself names none".
   */
  readonly names: readonly string[]
  /**
   * An external list of tool names, read and resolved by the plugin — see
   * `./tool-names.ts`, which owns the file format, the conservative fallback and
   * the per-session pin. The op's effective names are the UNION of {@link names}
   * and this list, so a rule that names `schedule_create` keeps stripping it even
   * when the file is missing, and the file can only ever widen the strip.
   *
   * A path, absolute or relative to the rule file's own directory. Absent (the
   * default) means the op has no dynamic half, which is exactly this op's original
   * behaviour.
   */
  readonly namesFrom?: string
  /**
   * Measure and log without removing. Default \`true\`: an operator turns the
   * removal on deliberately, after reading what the measurement says.
   */
  readonly dryRun: boolean
  /**
   * What the last application measured. Written by {@link applyTransformOp} and
   * read by the caller for its log line — the op itself is otherwise pure, and
   * the caller may not run one at all.
   */
  lastReport?: StripToolDeclsReport
  /** Why the last application refused, when it did. */
  lastRefusal?: { readonly check: string; readonly problem: string }
}

/** One op's measurement, for the caller's log line. */
export interface StripToolDeclsReport {
  readonly dryRun: boolean
  readonly removedChars: number
  readonly tools: readonly { readonly name: string; readonly argsChars: number; readonly outputChars: number }[]
  /**
   * Names that were requested and are NOT declared in this assembly's text.
   *
   * Reported, never fatal: a tool that is not visible to this agent is simply not
   * rendered, and a dynamic list is expected to name tools that only some agents
   * see. It is carried this far so the operator's line can say which requests went
   * unanswered instead of the request list being silently absorbed.
   */
  readonly missing: readonly string[]
}

/**
 * Remove every JSDoc comment block inside the two declaration maps, keeping every
 * type signature. Text-only, exactly like {@link StripToolDeclsOp}: the sandbox
 * binding never reads this text, so tools stay callable. Default `dryRun: true`
 * so a shipped rule measures before it removes.
 */
export interface StripDocCommentsOp {
  readonly op: 'stripDocComments'
  /** Measure and log without removing. Default `true`. */
  readonly dryRun: boolean
  /** What the last application measured. */
  lastReport?: DocStripReport
  /** Why the last application refused, when it did. */
  lastRefusal?: { readonly check: string; readonly problem: string }
}

/**
 * Replace the text a regular expression matches WITHIN single lines, leaving the
 * line structure alone.
 *
 * The gap this closes: every other op here is line-granular. \`dropLines\` and
 * \`keepLines\` decide a whole line's fate, \`keepBlocks\` decides a whole block's,
 * and the two strip ops remove whole declarations or comments. None of them can
 * shorten a long description that sits on ONE line — a single-line \`/** … *​/\`
 * doc comment, say — without deleting the sentence that says what the thing is.
 *
 * WHY \`expect\` EXISTS, and why it is this op's whole safety value. These rules
 * aim at text this package does NOT own: the descriptions rendered from the tool
 * SDK. When upstream rewrites the sentence a pattern was written against, a
 * replace either stops matching — silence, which an operator only notices by
 * measuring — or, worse, starts matching somewhere adjacent and rewrites prose
 * nobody meant to touch. \`expect\` turns both into a refusal: the operator writes
 * down how many substitutions the rule is supposed to make, and a run that makes
 * a different number changes NOTHING and says so. Without \`expect\` the count is
 * still measured and reported, so the number to write down can be read off a
 * first, deliberate run.
 *
 * WHAT \`replacement\` MEANS, exactly. It is a JavaScript replacement string, so
 * \`$\` is NOT literal: \`$&\`, \`$1\`…\`$9\`, \`$\`\`\`, \`$'\` and \`$<name>\` are the
 * engine's substitution syntax, and a literal dollar sign is written \`$$\`. That
 * is a decision, not an accident — see the report for why it beats escaping
 * every \`$\` — and the consequence to keep in mind while authoring is that a
 * replacement copied out of English prose keeps its dollars literally ONLY when
 * they spell none of those forms.
 */
export interface ReplaceTextOp {
  readonly op: 'replaceText'
  /** The pattern, compiled once, as the rule file spells it. */
  readonly pattern: RegExp
  /** The pattern's source, kept for diagnostics — the same pairing \`dropLines\` keeps. */
  readonly source: string
  /** The substitution text, in JavaScript replacement-string syntax (see above). */
  readonly replacement: string
  /** The compiled flags. Default \`'g'\`; \`'g'\` is REQUIRED, since a replacement that stops at the first match is not what this op is for. */
  readonly flags: string
  /** Measure and log without replacing. Default \`true\`, like the two strip ops. */
  readonly dryRun: boolean
  /**
   * How many substitutions this rule is supposed to make. Absent means "replace
   * everything the pattern matches". Present means the run is REFUSED, with the
   * text returned unchanged, when the actual count differs — which is how a rule
   * written against today's upstream text fails loudly after upstream rewrites it.
   */
  readonly expect?: number
  /**
   * What the last application measured. Written by {@link applyTransformOp} and
   * read by the caller for its log line. It is written ONLY when the text was
   * actually transformed or deliberately measured — a refused run leaves this
   * field as it was, so a stale number can never be read off a refusal.
   */
  lastReport?: ReplaceTextReport
  /** Why the last application refused, when it did. */
  lastRefusal?: { readonly check: string; readonly problem: string }
}

/** One \`replaceText\` measurement, for the caller's log line. */
export interface ReplaceTextReport {
  readonly dryRun: boolean
  /** Substitutions the pattern matched — what \`replace\` would have made, and what it did make when not a dry run. */
  readonly replacements: number
  /** Characters the text lost; NEGATIVE when the replacement is longer than the match. */
  readonly removedChars: number
}

/** The closed set of transform operations. */
export type TransformOp = DropLinesOp | KeepLinesOp | KeepBlocksOp | StripToolDeclsOp | StripDocCommentsOp | ReplaceTextOp

/** The discriminator values, for validation and diagnostics. */
export const TRANSFORM_OPS: readonly TransformOp['op'][] = ['dropLines', 'keepLines', 'keepBlocks', 'stripToolDecls', 'stripDocComments', 'replaceText']

/** Split text into lines the way every transform measures them. */
function linesOf(text: string): string[] {
  return text.split('\n')
}

/**
 * Count the substitutions a global `replace` would make, by running the same
 * search without substituting.
 *
 * Counted combinatorially — the number of places a NON-OVERLAPPING match starts —
 * rather than by looping `exec`, because that is exactly what `String.replace`
 * consumes, and a zero-length match, which makes a manual loop depend on the
 * engine's advancing rule, would then count differently from the replacement it
 * claims to predict.
 */
function countReplacements(text: string, pattern: RegExp): number {
  let count = 0
  for (const _match of text.matchAll(pattern)) count += 1
  return count
}

/**
 * The single point where a `replaceText` run gives up, so there is exactly one
 * refusal path and exactly one sentence shape for it.
 * @param op - the op, mutated to carry the refusal.
 * @param check - which rule the run failed.
 * @param problem - the sentence the operator reads.
 * @param text - the input text, returned untouched.
 * @returns the input text, unchanged.
 */
function refuseReplace(op: ReplaceTextOp, check: string, problem: string, text: string): string {
  op.lastRefusal = { check, problem }
  return text
}

/**
 * Apply one operation.
 * @param text - the section's text for THIS scope; never mutated.
 * @param op - the compiled operation.
 * @returns the transformed text. A new string, always.
 */
export function applyTransformOp(text: string, op: TransformOp): string {
  switch (op.op) {
    case 'dropLines':
      return linesOf(text).filter(line => !op.pattern.test(line)).join('\n')
    case 'keepLines': {
      const kept: string[] = []
      let pendingBlank = false
      for (const line of linesOf(text)) {
        if (op.pattern.test(line)) {
          if (pendingBlank && kept.length > 0) kept.push('')
          pendingBlank = false
          kept.push(line)
          continue
        }
        if (line.trim().length === 0) pendingBlank = true
      }
      return kept.join('\n')
    }
    case 'stripToolDecls': {
      // The only op whose failure mode is decided by a measurement rather than
      // by its own correctness: \`stripToolDeclarations\` returns the input text
      // on every refusal, so a broken strip is a no-op and never a partial one.
      const outcome = stripToolDeclarations(text, op.names, op.dryRun)
      if (!outcome.ok) {
        // Not thrown: throwing would abort the whole assembly for a pass whose
        // whole job is to be optional. The refusal is carried on the op instead,
        // and the caller logs it.
        op.lastRefusal = { check: outcome.refusal.check, problem: outcome.refusal.problem }
        return text
      }
      op.lastReport = {
        dryRun: op.dryRun,
        removedChars: outcome.removedChars,
        tools: outcome.removed,
        missing: outcome.missing,
      }
      return outcome.text
    }
    case 'stripDocComments': {
      // Same refusal discipline as stripToolDecls: a partial comment strip would
      // publish half a declaration, so every failure returns the text unchanged.
      const outcome = stripDeclarationComments(text, op.dryRun)
      if (!outcome.ok) {
        op.lastRefusal = { check: outcome.refusal.check, problem: outcome.refusal.problem }
        return text
      }
      op.lastReport = outcome.report
      return outcome.text
    }
    case 'replaceText': {
      // TIME TO SHAPE-CHECK, because this op is not always the loader's product:
      // it is also built by hand in tests, by external callers, and by whatever
      // rule format comes next. A `pattern` that is a string reaches `matchAll`
      // as a TypeError, and the refusal below turns that into the sentence an
      // operator can act on rather than an exception into the waterfall.
      let pattern: RegExp
      try {
        pattern = op.pattern instanceof RegExp
          ? new RegExp(op.pattern.source, op.pattern.flags)
          : new RegExp(String(op.pattern as unknown), op.flags)
      } catch (error: unknown) {
        const reason = error instanceof Error ? error.message : String(error)
        return refuseReplace(op, 'pattern', `the pattern could not be compiled: ${reason}`, text)
      }
      // The global flag is this op's reason to exist: without it `replace` stops
      // after the first match and leaves a half-rewritten line, which is precisely
      // the partial result every op here refuses to publish.
      if (!pattern.global) {
        return refuseReplace(op, 'flags', `the flags must include "g", otherwise only the first match would be replaced (received ${JSON.stringify(op.flags ?? '')})`, text)
      }
      // A pattern that can match NOTHING matches at every character boundary, so
      // the "replacement" is an insertion between characters — a rule whose effect
      // cannot be read off the rule. Measured over the empty string, which is the
      // shortest text such a match applies to.
      pattern.lastIndex = 0
      if (pattern.test('')) {
        return refuseReplace(op, 'pattern', `the pattern ${JSON.stringify(pattern.source)} matches empty text, so replacing it would insert text between characters`, text)
      }
      // The SAME statefulness: a fresh clone never carries a `lastIndex` left by
      // another session's run.
      pattern.lastIndex = 0
      const replacements = countReplacements(text, pattern)
      // The safety valve, and the order matters: the count is checked BEFORE any
      // substitution, so a mismatch cannot have already half-rewritten the line.
      if (op.expect !== undefined && op.expect !== replacements) {
        return refuseReplace(op, 'expect', `expected ${op.expect} replacement(s), found ${replacements}`, text)
      }
      pattern.lastIndex = 0
      const replaced = text.replace(pattern, op.replacement)
      // NOT `replaced.length - text.length`: that is the GAIN, and the field is
      // named for what the section lost. A replacement longer than the match
      // therefore reports a negative number rather than hiding the sign.
      op.lastReport = { dryRun: op.dryRun, replacements, removedChars: text.length - replaced.length }
      // `dryRun` returns the MEASURED input, never a middle ground: the count above
      // was taken over the whole text, and the number an operator reads is the one a
      // real run would produce.
      return op.dryRun ? text : replaced
    }
    case 'keepBlocks': {
      const lines = linesOf(text)
      const kept: string[] = []
      let index = 0
      // The preamble: everything before the first header line is not part of any
      // block and is kept verbatim.
      while (index < lines.length && !op.headerPattern.test(lines[index] ?? '')) {
        kept.push(lines[index] ?? '')
        index += 1
      }
      while (index < lines.length) {
        const header = lines[index] ?? ''
        const body: string[] = []
        index += 1
        while (index < lines.length && !op.headerPattern.test(lines[index] ?? '')) {
          body.push(lines[index] ?? '')
          index += 1
        }
        const keep = op.keepPattern.test(header) && !(op.denyPattern?.test(header) ?? false)
        if (keep) kept.push(header, ...body)
      }
      return kept.join('\n')
    }
    default: {
      const exhaustive: never = op
      throw new Error(`prompt-plan: unknown transform operation ${JSON.stringify(exhaustive)}`)
    }
  }
}

/**
 * Apply a rule's whole operation list, in file order.
 *
 * Order is significant and stated rather than implied: `dropLines` before
 * `keepBlocks` is a different text from the reverse, and a rule file is read
 * top-to-bottom, so the list is applied top-to-bottom.
 * @param text - the section's text for this scope.
 * @param ops - the compiled operations, in file order.
 * @returns the transformed text.
 */
export function applyTransform(text: string, ops: readonly TransformOp[]): string {
  let current = text
  for (const op of ops) current = applyTransformOp(current, op)
  return current
}

/**
 * Describe a transform for a trace line, without the pattern bodies.
 * @param ops - the compiled operations.
 * @returns a short human description.
 */
export function describeTransform(ops: readonly TransformOp[]): string {
  return `transform [${ops.map(op => op.op === 'keepBlocks'
    ? `keepBlocks /${op.headerSource}/`
    : op.op === 'stripToolDecls'
      ? `stripToolDecls [${op.names.join(', ')}]${op.namesFrom === undefined ? '' : ` + namesFrom ${op.namesFrom}`}${op.dryRun ? ' (dryRun)' : ''}`
      : op.op === 'stripDocComments'
        ? `stripDocComments${op.dryRun ? ' (dryRun)' : ''}`
        : op.op === 'replaceText'
          // The replacement is quoted and the PATTERN is not, which is the shape
          // that reads unambiguously when the replacement itself contains a '/'.
          ? `replaceText /${op.source}/${op.flags} -> ${JSON.stringify(op.replacement)}${op.expect === undefined ? '' : ` expect ${op.expect}`}${op.dryRun ? ' (dryRun)' : ''}`
          : `${op.op} /${op.source}/`).join('; ')}]`
}
