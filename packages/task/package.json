{
  "name": "@t4r71/dsh-task",
  "description": "One first-class task tool: owns the task tree and the child agents working it (async dispatch, preset persona + tool filter, status and result collection)",
  "version": "0.1.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T4R71/dsh-plugins.git",
    "directory": "packages/task"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx/esm --test tests/presets.spec.ts tests/task.spec.ts tests/ask-proxy.spec.ts tests/worktree.spec.ts tests/child-sandbox.spec.ts tests/qa-thread.spec.ts"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "icon.svg",
    "locale/*.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-subagent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2"
  },
  "icon": "./icon.svg"
}
