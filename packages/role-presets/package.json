{
  "name": "@t4r71/dsh-role-presets",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "把 .agent-presets/role-*/ 下的角色目录注册进名册：0.2.0-rc.2 的 agent-preset 是注册制，没有任何东西扫盘，这个包补上那一步。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx/esm --test tests/*.spec.ts"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": "T4R71 <T4R71@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T4R71/dsh-plugins.git",
    "directory": "packages/role-presets"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "role"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
