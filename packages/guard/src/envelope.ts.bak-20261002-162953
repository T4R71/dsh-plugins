/**
 * Items 5 and 6 — the settle-envelope rule for subagent closing messages.
 *
 * ## The problem
 *
 * \`@deepseek-ai/dsh-subagent\` delivers a settled child's closing message into
 * the parent as a *plain* durable \`user\` message whose third text block is the
 * child's entire final answer, unbounded
 * (\`dsh-subagent/lib/index.js:633-654\`, \`createSettlementMessage\`; the
 * concatenation at \`:640-646\` has no cap, and the only bounded field is
 * \`source.summary\`, which never reaches a model).
 *
 * Measured on this deployment's parent session: 29 settlement messages,
 * 172,344 characters of JSON / 160,237 characters of text, largest single
 * closing message 15,562 characters.
 *
 * ## Why an envelope and not a truncation
 *
 * A child's closing message is the *result of the work*. Dropping any of it is
 * not a saving, it is a lost deliverable, so the rule is not keep-the-head.
 * It is: the full text is written to disk and hashed, and what enters the
 * parent's transcript is a pointer plus the sections the dispatch brief asked
 * the child to lead with. The parent can always read the rest back — the
 * envelope names where it is and what it hashes to, so the parent can also
 * verify that what it reads back is what the child wrote.
 *
 * ## The seam, and why it does not cost a cache miss
 *
 * The settlement message is \`role: 'user'\` and travels through
 * \`parent.inbox\` -> \`dsh-agent-loop/lib/index.js:906 claim()\` ->
 * \`:912\` \`payload.messages\` of the \`agent/pre-step\` waterfall; the listener's
 * return value is what \`:1061\` commits and \`:1063\` builds the request from.
 * Replacing it there happens *before the first commit*, so the original never
 * enters a prompt prefix and no cache is invalidated. \`dsh-agent\`'s own
 * \`disposeNotice\` listener (\`dsh-agent/lib/index.js:193-204\`) rewrites the same
 * array, which is the precedent.
 *
 * The analysis behind all of the above is \`M:/DSH-T4/scratch/settle-envelope.md\`
 * and \`M:/DSH-T4/scratch/json-mode.md\`; those conclusions are taken as given
 * and are not re-derived here.
 *
 * ## The report is the control plane
 *
 * The one thing a parent cannot defer is "did this child finish, and what did it
 * say it did". Children write that as `状态：完成` / `状态：失败` plus one summary
 * line, and `@t4r71/dsh-task` resolves a node's verdict from exactly those two
 * lines (`packages/task/src/index.ts:2347`). An envelope that carried "结论 /
 * 证据 / 判不了" heads but dropped the report turned every finished node into
 * `状态：未收到回报`, which is a failure — so the report is published verbatim,
 * directly under the harness's own lead-in, and everything else is a pointer or a
 * bounded excerpt.
 *
 * ## Control plane, not data plane
 *
 * The parent decides the next dispatch from the envelope alone. Its evidence
 * ("how do I know") and its open questions ("what is still unknown") are data
 * plane: the parent `read`s those back when a decision actually turns on them,
 * and pays for them only then. Measured on 39 real spilled closing messages,
 * 25 of which matched no heading at all, the default envelope body is 457
 * characters on average against 4,267 of closing text; `settleEnvelopeGistChars`
 * is the hard ceiling over that body.
 *
 * ## Item 6: the section convention
 *
 * JSON mode is not reachable — \`LlmCallConfig\`
 * (\`dsh-llm/lib/typert.host.js:340-341\`) has no output-format field, and
 * \`task\` can only start a *continuable* child
 * (\`packages/task/src/index.ts:1432\` \`startContinuable\`), whose spec type
 * omits \`outputSchema\` (\`dsh-subagent/lib/typert.host.js:346-348\`). So the
 * substitute is a convention on both sides: the dispatch brief asks the child
 * to lead its closing message with a fixed set of sections, and the envelope
 * shows those sections' first lines while spilling the whole message.
 *
 * ## Fidelity guarantee
 *
 * - The full closing text is always written before the envelope is built; if
 *   the write fails, the message is left untouched rather than replaced by a
 *   pointer that leads nowhere.
 * - The envelope carries the \`sha256\` of the exact spilled text, so a reader
 *   can prove the read-back matches.
 * - With \`settleEnvelope: false\` nothing in this module runs and the message
 *   is committed byte-for-byte as the harness built it.
 *
 * @module @t4r71/dsh-guard/envelope
 */

import type { ContentBlock, UserMessage } from '@deepseek-ai/dsh-llm'
import { byteLength, sha256Hex, spillDirectory, writeSpill } from './spill.ts'

/** Whether settle-envelope rewriting is willing to run. */
export interface EnvelopeDecision {
  /** The switch; \`false\` returns every message untouched. */
  readonly enabled: boolean
  /**
   * How many leading lines of each requested section the envelope shows.
   *
   * Only reachable when the child reported no verdict *and* no
   * {@link EnvelopeDecision.gistChars} budget is set: the report is the envelope
   * now, and the sections are data plane that the parent reads back on demand.
   */
  readonly headLines: number
  /**
   * Headings the envelope looks for. Omitted or empty means
   * {@link ENVELOPE_SECTIONS}, which is what every caller got before this field
   * existed.
   */
  readonly sections?: readonly string[]
  /**
   * Hard ceiling, in characters, on the fallback excerpt the envelope carries
   * when the child reported no verdict (no status line to publish).
   *
   * `0` (default) carries none: the envelope is the status report plus the
   * pointer, and a child that reported nothing is diagnosed without an excerpt.
   * `>0` carries the opening of the closing message, up to this many characters,
   * because with no report a bare pointer would force the parent to read the file
   * before it could tell whether the child even finished.
   *
   * The body never exceeds it, whatever the child wrote: a line that would cross
   * the budget is cut at the budget, and the budget is closed for good after
   * that. An excerpt is not a bound, and this field would be pointless if it
   * were not.
   */
  readonly gistChars?: number
}

/** The section headings the dispatch brief asks a child to lead with, in order. */
export const ENVELOPE_SECTIONS = ['结论', '证据', '判不了']

/** The harness's own lead-ins, which the envelope keeps verbatim. */
const CLOSING_LEAD_IN = 'Its closing message:'
const NO_CLOSING = 'It left no closing message.'

/** Every text block of a message, in order; \`undefined\` when any block is not text. */
function textsOf(content: readonly ContentBlock[]): string[] | undefined {
  const out: string[] = []
  for (const block of content) {
    if (block.type !== 'text') return undefined
    out.push(block.text)
  }
  return out
}

/** The headings to look for, or the default set when none were configured. */
export function sectionOrder(sections?: readonly string[]): readonly string[] {
  return sections === undefined || sections.length === 0 ? ENVELOPE_SECTIONS : sections
}

/** Marked at the end of an excerpt so a reader can tell it was cut. */
const EXCERPT_MARK = '…'

/**
 * The longest prefix of `text` that fits `limit`, cut on a line boundary when
 * one is inside the cut and hard at the limit when there is none.
 *
 * The line-boundary preference is what keeps a multi-line excerpt readable; the
 * hard cut is what makes the budget a bound. Both return at most `limit`
 * characters — that is the contract, not an approximation of it.
 *
 * @param text - the text to bound.
 * @param limit - the character budget; `0` keeps nothing.
 * @returns at most `limit` characters, with an ellipsis when text was dropped.
 */
export function boundText(text: string, limit: number): string {
  if (limit <= 0) return ''
  const characters = Array.from(text)
  if (characters.length <= limit) return text
  const head = characters.slice(0, limit).join('')
  const lastBreak = head.lastIndexOf('\n')
  if (lastBreak > 0) return head.slice(0, lastBreak)
  return characters.slice(0, Math.max(1, limit - 1)).join('') + EXCERPT_MARK
}

/** One requested section found in a closing message. */
export interface FoundSection {
  /** The heading, normalised to the requested spelling. */
  readonly heading: string
  /** The first \`headLines\` lines of the section body. */
  readonly body: readonly string[]
}

/**
 * The requested sections present in a closing message, in the order they appear.
 *
 * Both the markdown form the brief asks for and a bare heading are accepted; a
 * child that wrote \`## 结论\` and one that wrote \`结论:\` mean the same thing, and
 * refusing one of them would make the convention a trap.
 *
 * @param closing - the child's closing text.
 * @param headLines - how many lines of a section body to keep.
 * @param sections - the headings to look for; omitted means {@link ENVELOPE_SECTIONS}.
 * @param gistChars - when `> 0`, the hard ceiling on the total characters of
 *   every body returned here. Headings are structure rather than gist, so they
 *   are not counted; the bodies are, and they stop the moment it is spent.
 * @returns one entry per heading found.
 */
export function leadingSections(
  closing: string,
  headLines: number,
  sections?: readonly string[],
  gistChars = 0,
): FoundSection[] {
  const wanted = sectionOrder(sections)
  const budget = gistChars > 0 ? gistChars : Number.POSITIVE_INFINITY
  let spent = 0
  const lines = closing.split('\n')
  const found: FoundSection[] = []
  for (let index = 0; index < lines.length; index += 1) {
    const trimmed = (lines[index] as string).trim()
    let heading: string | undefined
    // Text following the heading on its own line, as in `结论：ok`. A child that
    // writes the section and its first sentence together is following the
    // instruction, not breaking it, so this is captured rather than dropped —
    // otherwise the heading would be recognised and its content thrown away.
    let inline: string | undefined
    for (const section of wanted) {
      if (trimmed === '## ' + section || trimmed === '##' + section
        || trimmed === section || trimmed === section + ':' || trimmed === section + '：') {
        heading = section
        break
      }
      for (const separator of [':', '：']) {
        for (const prefix of ['## ' + section, '##' + section, section]) {
          const lead = prefix + separator
          if (trimmed.startsWith(lead) && trimmed.length > lead.length) {
            heading = section
            inline = trimmed.slice(lead.length)
            break
          }
        }
        if (heading !== undefined) break
      }
      if (heading !== undefined) break
    }
    if (heading === undefined) continue
    const body: string[] = []
    if (inline !== undefined && headLines > 0) body.push(inline)
    for (let i = index + 1; i < lines.length && body.length < headLines; i += 1) {
      // The budget is checked before a line is kept rather than after, so one
      // line over the ceiling becomes an exact-character cut instead of an
      // overrun; and it stays closed once spent, so a later heading cannot push
      // the total back over it.
      if (spent >= budget) break
      const candidate = lines[i] as string
      // A blank line ends the section. Without this the separator a child puts
      // between two headings is counted as body, so a budget of one line shows
      // the heading's first line plus the gap — which is how the envelope came
      // to spend its display budget on whitespace.
      if (candidate.trim() === '') break
      if (candidate.trim().startsWith('##')) break
      if (budget !== Number.POSITIVE_INFINITY) {
        const cost = Array.from(candidate).length
        if (spent + cost > budget) {
          body.push(boundText(candidate, budget - spent))
          spent = budget
          break
        }
        spent += cost
      }
      body.push(candidate)
    }
    found.push({ heading, body })
  }
  return found
}

/**
 * The closing text with its section headings removed.
 *
 * The excerpt is what the parent reads when the child reported no verdict, and a
 * heading is a pointer to text that is not in the envelope — printing it would
 * spend the budget saying "there is more elsewhere" instead of saying what
 * happened. Prose the child wrote above its first heading is kept, because that
 * is usually where it says what it did.
 *
 * @param closing - the child's closing text.
 * @returns the prose without heading lines or the blank lines around them.
 */
function gistOnly(closing: string): string {
  return closing
    .split('\n')
    .filter(line => /^\s*#{0,2}\s*\S/.test(line))
    .filter(line => sectionOrder().every(section => !line.replace(/^\s*#+/, '').trim().startsWith(section)))
    .join('\n')
    .trim()
}

/**
 * The line a child reports its outcome on, copied from the consumer.
 *
 * `@t4r71/dsh-task` resolves a node's verdict by scanning a settlement body
 * *backwards* for this exact line (`packages/task/src/index.ts:2347`
 * `STATUS_LINE`, read at `:2380` `readNodeReplay`). An envelope that publishes
 * the report of a finished child without this line turns every node into
 * `状态：未收到回报` — a failure. It is the one piece of the closing message that
 * is control plane in the strictest sense, and it is why this module reads it
 * back out before anything else is considered.
 *
 * The full-width colon is deliberate: it is what the dispatch brief tells a child
 * to write. A copy, not an import — this package must not depend on the consumer
 * to compile, and the consumer's own comment says the wording has to match the
 * brief on both sides.
 */
const STATUS_LINE = /^\s*状态\s*[:：]\s*(完成|失败)\s*$/u

/**
 * The child's own verdict and its one-line summary, taken from the closing text.
 *
 * Both lines are returned byte-for-byte, because the consumer reads the status
 * line with a regular expression and the summary as the first non-empty line
 * after it. The status line is the *last* match, matching the consumer's
 * backwards scan: a child that quoted the protocol earlier in its body must not
 * outrank the report it just made.
 *
 * @param closing - the child's closing text.
 * @returns the verbatim report, or `undefined` when the child reported nothing.
 */
function statusExcerpt(closing: string): { head: string, line: string } | undefined {
  const lines = closing.split('\n')
  for (let i = lines.length - 1; i >= 0; i -= 1) {
    const line = lines[i] as string
    if (STATUS_LINE.exec(line) === null) continue
    let summary = ''
    for (let j = i + 1; j < lines.length; j += 1) {
      const candidate = lines[j] as string
      if (candidate.trim() === '') continue
      summary = candidate
      break
    }
    return { head: line, line: summary }
  }
  return undefined
}

/**
 * Build the content that replaces a settlement message's closing blocks.
 *
 * The returned blocks keep the harness's own lead-in lines, so the message
 * still reads as a settlement notice in the transcript, and then carry the
 * envelope. The original closing text is NOT reproduced: it is at the path the
 * envelope names, with its hash.
 *
 * @param message - the settlement message as the harness built it.
 * @param decision - whether and how to envelope.
 * @returns replacement content, or \`undefined\` to leave the message alone.
 */
export function envelopeContent(message: UserMessage, decision: EnvelopeDecision): ContentBlock[] | undefined {
  if (!decision.enabled) return undefined
  const source = message.source as { kind?: unknown, senderSessionId?: unknown } | undefined
  if (source?.kind !== 'subagent-settled') return undefined
  const texts = textsOf(message.content)
  if (texts === undefined) return undefined
  const marker = texts.indexOf(CLOSING_LEAD_IN)
  // A child that left nothing, or a shape this build does not recognise: the
  // message is already short, so there is nothing to save and nothing to risk.
  if (marker < 0 || texts.length <= marker + 1) return undefined
  if (texts.includes(NO_CLOSING)) return undefined

  const closing = texts.slice(marker + 1).join('')
  const childId = typeof source.senderSessionId === 'string' ? source.senderSessionId : 'unknown'
  const digest = sha256Hex(closing)
  const path = writeSpill(spillDirectory('settle', childId), digest.slice(0, 16) + '.md', closing)
  // The write is the whole recovery path. If it failed, handing over the
  // original is the only faithful choice; an envelope pointing at nothing would
  // be a silent loss of the child's work.
  if (path === undefined) return undefined

  const head = texts.slice(0, marker + 1)
  const wanted = sectionOrder(decision.sections)
  const gistChars = Math.max(0, decision.gistChars ?? 0)
  const lineCount = closing.split('\n').length
  const report = statusExcerpt(closing)
  const gist = gistChars > 0 ? boundText(gistOnly(closing), gistChars) : ''
  const found = leadingSections(closing, decision.headLines, wanted, gistChars)
  const excerpt = report !== undefined
    ? (report.line === '' ? report.head : report.head + '\n' + report.line)
    : gist
  // The report goes directly under the harness's own lead-in, because that is
  // where a reader looks for the verdict; everything else about the message is
  // one read away.
  const envelope: string[] = []
  if (excerpt !== '') envelope.push('', excerpt)
  envelope.push(
    '',
    'Envelope of its closing message (' + String(byteLength(closing)) + ' bytes, '
      + String(lineCount) + ' lines).',
    'Full text: ' + path,
    'sha256 ' + digest,
  )
  if (report !== undefined) {
    envelope.push('(its own report, verbatim; full text: ' + path
      + '; read it when you need the details)')
  } else if (gistChars > 0) {
    envelope.push('(a gist of ' + String(gistChars)
      + ' characters at most; read the full text above only when you need the details)')
  } else if (found.length === 0) {
    envelope.push('It used none of the requested section headings ('
      + wanted.join(' / ') + '); read the full text at the path above.')
  } else {
    // A child that reported nothing, with no gist budget: the pointer is the
    // whole envelope. Printing the section heads here would put evidence and open
    // questions back into every parent's transcript, which is what this shape
    // exists to stop; the parent reads them from the spill when a decision turns
    // on them.
    envelope.push('(it left no 状态 line; read the full text at the path above)')
  }

  return [
    ...head.map(text => ({ type: 'text' as const, text })),
    { type: 'text' as const, text: envelope.join('\n') },
  ]
}
