  * is to calibrate thresholds against real traffic.
  */
  verbose: z.boolean().default(false),
  /** Continuations steered per session by the turn-completion rule. */
  idleBudget: z.number().min(0).max(64).default(3),
  /** Minimum reasoning length before a turn counts as idle. */
  minReasoningChars: z.number().min(0).max(1000000).default(0),
  /** Offer the automatic-retry fallback tier. */
  retryEnabled: z.boolean().default(DEFAULT_RETRY_POLICY.enabled),
  /** Automatic retries and recovery continuations per session. */
  retryMax: z.number().min(0).max(64).default(DEFAULT_RETRY_POLICY.maxRetries),
  /** Delay before a fallback retry or a recovery continuation, in ms. */
  retryDelayMs: z.number().min(0).max(60000).default(DEFAULT_RETRY_POLICY.delayMs),
  /** Failure codes the fallback tier retries. */
  retryCodes: z.array(z.string()).default([...DEFAULT_RETRY_POLICY.codes]),
  /** Steer a recovery continuation for an assistant message with no blocks. */
  retryOnEmpty: z.boolean().default(DEFAULT_RETRY_POLICY.onEmptyResponse),
  /** Steer a recovery continuation for a turn that ended on reasoning alone. */
  retryOnDegenerate: z.boolean().default(DEFAULT_RETRY_POLICY.onDegenerateTurn),
  /** Append one line to this file every time `apply` runs; empty means off. */
  receiptFile: z.string().default(''),
  /** Bound the logged copy of an oversized `job_output`; see {@link Config.jobOutputBound}. */
