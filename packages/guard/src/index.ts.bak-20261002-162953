/** Resolved configuration. */
export type ResolvedConfig = Config

/** Per-session guard state. */
interface SessionState {
  /** Turn the counters below belong to; a new turn resets the per-turn one. */
  lastTurn: number
  /** Continuations steered during the current turn. */
  turnContinues: number
  /** Continuations steered over the session's lifetime. */
  spentContinues: number
  /** Hesitation nudges injected over the session's lifetime. */
  spentNudges: number
  /** Signature of the transcript already judged, so one churn is nudged once. */
  judged: string
  // -- fields added by the merge; see the arbitration listener at the bottom.
  // `idle-guard` kept its own `judged` and `steered` counters, and both names
  // collide with the stream guard's, so they are renamed apart rather than
  // shared: sharing them would have changed when each guard fires.
  /** Turn-completion continuations steered over the session's lifetime. */
  idleSteered: number
  /** Id of the last assistant message the turn-completion rule judged. */
  idleJudged: string
}

/** Where a brake left the stream, recorded for the turn-stopping hook. */
interface BrakeRecord {
  /** The channel that collapsed. */
  channel: Channel
  /** Which rule fired. */
  kind: 'announce' | 'repeat' | 'echo'
  /** Hits or lines counted when the verdict fired. */
  count: number
  /** Distinct line labels, for the recycling rule; `0` otherwise. */
  span: number
  /** The clause that completed an announcement run; for the log only. */
  opener: string
}

/**
 * The wording to inject for one agent, matched to its conversation's language.
 *
 * Read at injection time rather than cached, because the first nudge of a
 * session can precede any human turn the guard has seen, and a conversation can
 * legitimately change language mid-session.
 *
 * @param session - the session whose transcript decides the language.
 * @returns the wording set for that conversation.
 */
function wordingForAgent(session: Session): Wording {
  return wordingFor(prefersCjk(session.deriveMessages()))
}

export function apply(ctx: Context, config: ResolvedConfig): void {
  // The receipt, and the first statement in apply on purpose: it is the only
  // evidence that this row was mounted rather than denied by the loader's
  // compatibility preflight. Failure to write it is not a guard failure, so the
  // error is swallowed.
  if ((config.receiptFile ?? '') !== '') {
    try {
      appendFileSync(config.receiptFile as string, new Date().toISOString()
        + ' pid=' + String(process.pid) + ' guard: apply\n')
    } catch {
      /* a receipt is diagnostics, never a reason to fail a plugin load */
    }
  }

  // schemastery's `.default()` fills these in for a loader-validated config, but
  // a direct caller may omit them; resolve once here so the hot path reads plain
  // booleans and numbers.
  const enabled = config.enabled ?? true
  const brakeReasoning = config.brakeReasoning ?? false
  const announceMax = config.announceMax ?? 18
  const announceGap = config.announceGap ?? 20
  const announceCount = config.announceCount ?? 5
  const echoMin = config.echoMin ?? 0.9
  const maxContinues = config.maxContinues ?? 2
  const warnAfterContinues = config.warnAfterContinues ?? 10
  const hesitationNudge = config.hesitationNudge ?? true
  const hesitationBudget = config.hesitationBudget ?? 2
  const verbose = config.verbose ?? false
  // -- merged, and new.
  const streamGuard = config.streamGuard ?? true
  const idleGuard = config.idleGuard ?? true
  const idleBudget = config.idleBudget ?? 3
  const minReasoningChars = config.minReasoningChars ?? 0
  // ---- the six profile-facing switches, resolved once ----------------------
  const jobOutputBound = config.jobOutputBound ?? true
  const jobOutputMaxBytes = config.jobOutputMaxBytes ?? 12_000
  const costLedger = config.costLedger ?? true
  const costLedgerFile = (config.costLedgerFile ?? '') !== ''
    ? (config.costLedgerFile as string)
    : join(tmpdir(), 'dsh-guard', 'compaction-cost.jsonl')
  const dedupeInjectionsOn = config.dedupeInjections ?? true
  const suppressRepeatReads = config.suppressRepeatReads ?? false
  const settleEnvelope = config.settleEnvelope ?? true
  const settleEnvelopeHeadLines = config.settleEnvelopeHeadLines ?? 8
  const settleEnvelopeSections = sectionOrder(config.settleEnvelopeSections)
  const settleEnvelopeGistChars = config.settleEnvelopeGistChars ?? 0
  /** `read` stamps per session, keyed by session then by {@link rereadKey}. */
  const readStamps = new Map<SessionId, Map<string, ReadStamp>>()

  const retry = new RetryLedger({
    enabled: config.retryEnabled ?? DEFAULT_RETRY_POLICY.enabled,
    maxRetries: config.retryMax ?? DEFAULT_RETRY_POLICY.maxRetries,
    delayMs: config.retryDelayMs ?? DEFAULT_RETRY_POLICY.delayMs,
    codes: config.retryCodes ?? DEFAULT_RETRY_POLICY.codes,
    onEmptyResponse: config.retryOnEmpty ?? DEFAULT_RETRY_POLICY.onEmptyResponse,
    onDegenerateTurn: config.retryOnDegenerate ?? DEFAULT_RETRY_POLICY.onDegenerateTurn,
  })

  /** Per-session budgets. Keyed by id: the stream hook carries no Session object. */
  const states = new Map<SessionId, SessionState>()
  /** Brake recorded during a stream, consumed by the turn-stopping hook. */
  const brakes = new Map<SessionId, BrakeRecord>()
  /**
   * The boundary token last injected on, per session.
   *
   * This is the shared state that removes duplicate injection. A turn boundary
   * is identified by `turn:lastAssistantMessageId`; when the two guards were
   * separate packages each decided on its own and a boundary the brake had
   * already claimed could be claimed again by the turn-completion rule. One
   * map, checked once at the top of the arbitration listener, is the whole
   * mechanism — see `injected.get(sessionId) === boundary` below.
   */
  const injected = new Map<SessionId, string>()

  const stateOf = (id: SessionId): SessionState => {
    let state = states.get(id)
    if (state === undefined) {
      state = {
        lastTurn: 0,
        turnContinues: 0,
        spentContinues: 0,
        spentNudges: 0,
        judged: '',
        idleSteered: 0,
        idleJudged: '',
      }
      states.set(id, state)
    }
    return state
  }

  const log = (...args: unknown[]): void => {
    if (verbose) ctx.logger.info('[guard]', ...args)
  }

  ctx.on('llm/stream', (options, next) => {
    const sessionId = options.sessionId
    // A hand-built one-shot call has no session, so there is no turn to
    // continue and no transcript to judge. Leave it entirely alone.
    if (sessionId === undefined || !enabled) return next()

    return (async function* guarded(): AsyncIterable<StreamChunk> {
      /** Layer one, one announcement counter per channel. */
      const announces: Record<Channel, AnnounceGuard> = {
        text: new AnnounceGuard(announceGap, announceCount, announceMax),
        reasoning: new AnnounceGuard(announceGap, announceCount, announceMax),
      }
      /** Layer two R1, one recycling counter per channel. */
      const repeats: Record<Channel, RepeatGuard> = {
        text: new RepeatGuard(),
        reasoning: new RepeatGuard(),
      }
      /** Layer two R2, shared: it compares the text channel against the reasoning one. */
      const echoes = new EchoGuard(echoMin)
      /**
       * Open block indexes and their kind, so a brake knows exactly which blocks
       * it must close and whether closing them is safe at all.
       */
      const open = new Map<number, Channel | 'tool-call' | 'other'>()
      /**
       * Block indexes in first-seen stream order.
       *
       * The replay envelope is aligned to this order, not to the indexes
       * themselves (`llm/src/types.ts:407-415`), so a rebuilt envelope has to be
       * assembled against it rather than against a sorted index list.
       */
      const blockOrder: number[] = []
      /**
       * Text the brake truncated, per block index.
       *
       * Only truncated *reasoning* blocks need this: their signatures are
       * rewritten from it. A truncated text block keeps its signature, which is
       * id-only and takes its text from the block.
       */
      const truncated = new Map<number, string>()
      /**
       * The upstream replay envelope, captured from the `finish` chunk.
       *
       * A braked stream discards the upstream tail, but the `finish` still
       * arrives and still carries the envelope — the signature the provider
       * would replay. Capturing it is what lets the brake rewrite it instead of
       * forfeiting it.
       */
      let envelope: unknown
      /**
       * Text actually published per block index.
       *
       * A synthesized `block-end` must carry what the consumer already received:
       * the assembler treats the payload as authoritative and ignores deltas
       * after a close (`llm/src/assembler.ts:81`), so a payload disagreeing with
       * the live stream would make the settled message differ from what the user
       * watched arrive.
       */
      const streamed = new Map<number, string>()
      /** Upstream usage, kept so a brake does not silently drop accounting. */
      let usage: StreamChunk | null = null
      /** Once a brake fires, the rest of the upstream stream is discarded. */
      let braked = false
      /** The brake produced by this stream, if any. */
      let record: BrakeRecord | null = null

      /** A delta chunk, the only kind the guard reads or rewrites. */
      type DeltaChunk = Extract<StreamChunk, { type: 'text-delta' | 'reasoning-delta' }>

      /** Append published text and hand the chunk to the consumer. */
      function* publish(chunk: DeltaChunk, text: string): Generator<DeltaChunk> {
        if (text === '') return
        streamed.set(chunk.index, (streamed.get(chunk.index) ?? '') + text)
        yield { ...chunk, text }
      }

      /**
       * Whether a block that a brake must not disturb is open.
       *
       * A half-open tool call assembles to nothing
       * (`llm/src/assembler.ts:113-118`) and an unknown block type throws outright
       * (`:119`), so braking would corrupt the step rather than shorten the
       * answer. Every rule defers while this is true; each is monotone, so the
       * verdict is re-offered and nothing is lost by waiting.
       *
       * @returns true when a non-text block is open.
       */
      function blocking(): boolean {
        for (const kind of open.values()) {
          if (kind !== 'text' && kind !== 'reasoning') return true
        }
        return false
      }

      /**
       * Judge all three rules over one delta.
       *
       * Fed the **raw** delta rather than published text: none of these rules
       * holds anything back, so a verdict is about content the stream has already
       * produced and is independent of what the consumer has been handed.
       *
       * @param target - the channel the delta belongs to.
       * @param text - the delta itself.
       * @returns the brake to apply, or `null` to keep streaming.
       */
      function judge(target: Channel, text: string): BrakeRecord | null {
        if (blocking()) return null
        // R2 first: it is the only rule that reads both channels, so it must see
        // each delta before either per-channel rule can end the stream.
        if (target === 'reasoning') echoes.feedReasoning(text)
        else {
          const ev = echoes.feedText(text)
          if (ev !== null) {
            return { channel: target, kind: 'echo', count: ev.lines, span: 0, opener: '' }
          }
        }
        const rv = repeats[target].feed(text)
        if (rv !== null) {
          return { channel: target, kind: 'repeat', count: rv.lines, span: rv.distinct, opener: '' }
        }
        const av = announces[target].feed(text)
        if (av !== null) {
          // The verdict names which vocabulary completed the run, and the channel
          // decides whether that vocabulary's evidence is strong enough here. The
          // counter is deliberately not reset when a run is inadmissible: the run is
          // real, it is the *remedy* that differs by channel, and a later intent hit
          // completes the same run and brakes normally.
          if (target === 'text' || brakeReasoning || av.kind === 'intent') {
            return { channel: target, kind: 'announce', count: av.count, span: 0, opener: av.opener }
          }
        }
        return null
      }

      for await (const chunk of next()) {
        // After a brake the upstream tail is degenerate by construction, so it is
        // discarded wholesale — but the terminal frames still have to be rebuilt
        // here, because the grammar requires a `finish` and forbids leaving a
        // block open (`llm/src/invariant.ts:75-83`).
        if (braked) {
          if (chunk.type === 'usage') usage = chunk
          else if (chunk.type === 'finish') {
            // The upstream finish still carries the provider's replay envelope,
            // even though its text was discarded. Capture it before rebuilding:
            // it is the only source of the per-block signatures.
            if (chunk.replayState !== undefined) envelope = chunk.replayState
            // Close exactly the blocks this brake cut, from their published text,
            // in index order. Nothing was held back, so `streamed` is what the
            // consumer received and the only faithful source for the payload.
            for (const [index, kind] of [...open.entries()].sort((a, b) => a[0] - b[0])) {
              // Unreachable backstop. `braked` implies every open block is text or
              // reasoning: `judge()` refuses to brake while `blocking()` is true —
              // while any open value is neither — and a braked stream discards
              // block-starts instead of recording them, so `open` cannot gain such an
              // entry afterwards. Kept because that invariant spans two functions.
              /* v8 ignore next -- see the invariant above. */
              if (kind !== 'text' && kind !== 'reasoning') continue
              const text = streamed.get(index) ?? ''
              if (kind === 'reasoning') truncated.set(index, text)
              yield {
                type: 'block-end',
                index,
                block: kind === 'text' ? { type: 'text', text } : { type: 'reasoning', text },
              }
            }
            open.clear()
            if (usage !== null) yield usage
            // Emitted as a normal `stop`. It is not an error: the loop would treat
            // `error` as a failed attempt and re-run its retry ladder over the
            // same request. The turn continues through the steering below.
            //
            // The replay envelope is rebuilt rather than dropped, and the reason
            // is the asymmetry between the two signature kinds:
            //
            // - A **text** signature is `{v:1, id}` — measured, 3570 of them, none
            //   carrying text — so pi-ai takes the text from the block
            //   (`openai-responses-shared.js:156-161`). The published text is
            //   what reaches the wire, with the original item id intact.
            // - A **reasoning** signature is replayed *verbatim*: pi-ai pushes the
            //   stored item and ignores the block text entirely
            //   (`openai-responses-shared.js:137-141`). Passing the original
            //   through would re-send the very loop that was braked, so it is
            //   rewritten to describe what was published — see `signature.ts`.
            //
            // `rebuildBrakedEnvelope` returns `undefined` for any signature shape
            // this build does not recognise, and the envelope is then dropped
            // entirely. That degrades this one assistant message to
            // provider-neutral history (`llm-pi-ai/src/replay.ts:251`,
            // `llm-deepseek/src/protocols/messages/replay.ts:49`), which keeps the
            // recovered prefix in the transcript — verified: the next request
            // carries it as an unsigned `thinking` block. Guessing at an unknown
            // shape is never an option: a wrong signature silently ships the loop.
            const rebuilt = rebuildBrakedEnvelope(envelope, blockOrder, truncated)
            yield rebuilt === undefined
              ? { type: 'finish', reason: { kind: 'stop' } }
              : { type: 'finish', reason: { kind: 'stop' }, replayState: rebuilt as never }
          }
          continue
        }

        if (chunk.type === 'block-start') {
          blockOrder.push(chunk.index)
          open.set(chunk.index, chunk.blockType === 'text' || chunk.blockType === 'reasoning'
            ? chunk.blockType
            : chunk.blockType === 'tool-call' ? 'tool-call' : 'other')
          yield chunk
          continue
        }

        if (chunk.type === 'block-end') {
          open.delete(chunk.index)
          yield chunk
          continue
        }

        if (chunk.type === 'text-delta' || chunk.type === 'reasoning-delta') {
          const channel: Channel = chunk.type === 'text-delta' ? 'text' : 'reasoning'
          const brake = judge(channel, chunk.text)
          if (brake !== null) {
            record = brake
            braked = true
            log('brake', channel, 'rule', brake.kind, brake.kind === 'announce'
              ? `${brake.count} hits, last ${JSON.stringify(brake.opener)}`
              : brake.kind === 'echo'
                ? `${brake.count} lines restated`
                : `${brake.count} lines, ${brake.span} distinct`)
          }
          // Nothing is withheld, so the delta that completed the pattern is
          // published like any other: the brake stops the run growing, it does
          // not retract what the user has already been shown.
          yield* publish(chunk, chunk.text)
          continue
        }

        if (chunk.type === 'usage') {
          // Forwarded immediately, and deliberately *not* recorded as pending: a
          // usage chunk that arrived before the brake was already emitted, and
          // re-sending it at `finish` would trip the once-only rule
          // (`llm/src/invariant.ts:71`).
          yield chunk
          continue
        }

        if (chunk.type === 'finish') {
          // Only a stream that never braked reaches here; a braked one is
          // terminated in the `braked` branch above.
          yield chunk
          continue
        }

        yield chunk
      }

      // Publish the brake once the stream has settled, so the turn boundary sees
      // a record only for a stream that really was cut.
      if (record !== null) brakes.set(sessionId, record)
    })()
  })

  /**
   * The automatic-retry fallback tier.
   *
   * `next()` runs first and unconditionally: the shipped policy
   * (`@deepseek-ai/dsh-llm-retry`) owns every failure it already handles, and
   * this tier speaks only when that chain comes back without a retry — either
   * because the code is outside its `retryableCodes`, or because its own
   * `maxRetries` is spent (`dsh-llm-retry/lib/index.js:215-223`).
   *
   * There is no interaction with `repeat-tool-reminder`: that guard watches
   * `tools/post-execute` for a tool called the same way N times and injects a
   * reminder into the transcript. It never retries a request and never sees
   * this event. The two share no state and cannot double-fire.
   *
   * Ordering note: this listener is registered after the shipped policy, and a
   * cordis waterfall runs outermost-first, so this one is *inner*. When the
   * shipped policy decides to retry on its own it never calls `next()` and this
   * listener is not reached at all — which is the intended delegation, not a
   * bug. That is also why a failure recovered upstream leaves no line here.
   */
  ctx.on('agent/request-error', async (payload, next): Promise<RequestErrorAction> => {
    if (!enabled) return next()
    const downstream = await next()
    if (downstream?.kind === 'retry') return downstream
    const sessionId = payload.agent.session.id
    const verdict = retry.decideRequestFailure(sessionId, payload.failure.code)
    if (verdict.kind === 'decline') {
      log('request-error: fallback declined on', payload.failure.code, '—', verdict.reason)
      return downstream
    }
    if (!await cancellableDelay(verdict.delayMs, payload.signal)) return downstream
    retry.spend(sessionId)
    log('request-error: fallback retry', verdict.attempt, '/', retry.limit,
      'on', payload.failure.code, 'after', verdict.delayMs, 'ms')
    return { kind: 'retry' }
  })

  /**
   * The arbitration point: one listener for four rules that used to live in two
   * packages, and at most one injected message per turn boundary.
   *
   * Until the merge, `stream-guard` and `idle-guard` each registered their own
   * listener here. Neither returns a value, so cordis's serial dispatch never
   * bailed and both ran on every boundary — which is why the worst case was
   * 2 + 3 = 5 injected messages for one failure: up to `maxContinues` brake
   * continuations plus up to `idleBudget` idle continuations, and semantically
   * the same instruction in each. Both listeners also read the same
   * `deriveMessages().at(-1)`, so the waste was visible in the transcript.
   *
   * The rules are evaluated in a fixed order and the first admissible one
   * claims the boundary:
   *
   * 1. brake continuation (the streaming guard's remedy),
   * 2. empty-response recovery (the automatic-retry tier),
   * 3. idle continuation (the turn-completion guard's remedy),
   * 4. hesitation nudge.
   *
   * Every rule keeps its own trigger condition and its own budget. Nothing is
   * loosened: `maxContinues` is still per turn and still 2, `idleBudget` is still
   * per session and still 3, `hesitationBudget` is still per session and still 2.
   * What changes is only that a rule which loses the boundary does not also
   * inject, and does not spend its budget doing nothing.
   *
   * One deliberate non-deduplication: when the brake's per-turn allowance is
   * already spent, rule 1 falls through rather than returning. With the two
   * packages mounted side by side the turn-completion guard ran its own listener
   * at that boundary and still had its say; the merge preserves that, and removes
   * only the duplicate injection on a boundary the brake did claim.
   */
  ctx.on('agent/turn-stopping', async ({ agent, turn, signal }) => {
    if (!enabled) return

    const session = agent.session
    const sessionId = session.id
    const state = stateOf(sessionId)
    // The per-turn allowance is keyed on the turn number, not reset on every
    // step: a steered continuation re-enters `preStep` within the *same* turn
    // (`agent-loop/src/agent.ts:316-322`), so a per-step reset would hand the
    // turn an unlimited supply of continuations.
    if (state.lastTurn !== turn) {
      state.lastTurn = turn
      state.turnContinues = 0
    }

    // ---- SHARED STATE: one boundary token, one injection -------------------
    //
    // The token is `turn:lastAssistantMessageId`. Steering produces a new
    // assistant message, so the next boundary of the same turn has a different
    // token and is free again; two rules evaluating the *same* boundary see the
    // same token and the second one is skipped. That is the entire dedup
    // mechanism, and it is why the merge is one map rather than one rule
    // learning about another.
    const messages = session.deriveMessages()
    const last = messages.at(-1)
    const assistant = last !== undefined && last.role === 'assistant' ? last : undefined
    const boundary = String(turn) + ':' + (assistant?.id ?? 'none')
    if (injected.get(sessionId) === boundary) {
      log('boundary', boundary, 'already claimed; skipping a duplicate injection')
      return
    }
    /** Claim this boundary, so no later rule on it may inject again. */
    const claim = (): void => { injected.set(sessionId, boundary) }

    // ---- candidate 1: the brake continuation -------------------------------
    const record = brakes.get(sessionId)
    if (record !== undefined) {
      brakes.delete(sessionId)
      // Only the per-turn allowance stops steering. There is deliberately no
      // session-wide cap: when one existed, a session that spent it kept getting
      // braked but was never steered again, and because the only durable record
      // is the continuation message itself, that state was invisible in the
      // transcript — the turn just ended mid-thought. Past
      // `warnAfterContinues` the wording escalates instead of the guard giving up.
      if (state.turnContinues >= maxContinues) {
        log('continuation budget exhausted for turn', turn)
        // Falls through to the rules below on purpose — see the note above.
      } else if (streamGuard) {
        state.turnContinues += 1
        state.spentContinues += 1
        const warn = state.spentContinues > warnAfterContinues

        const wording = wordingForAgent(session)
      // Steering here is what keeps the turn alive: the machine re-reads its
      // inbox at this boundary and runs another step when fresh work is present
      // (`agent-loop/src/agent.ts:316-322`).
      //
      // The summary carries the diagnosis, not just the fact, because it is the
      // only durable evidence the guard leaves. `ctx.logger` output goes to a
      // 1000-message in-memory ring buffer that no shipped profile persists
      // (`vendor/cordis/src/logger.ts:213`), so a person screening a session
      // afterwards can read this line and nothing else. Naming the rule and the
      // channel here is what makes "why was my answer cut?" answerable without
      // reproducing the episode.
      //
      // No resume hint is attached, and that is deliberate rather than an
      // omission: nothing was held back, so there is no cut point to name. The
      // text the model wrote is in the transcript verbatim, and the plain
      // instruction to continue without repeating is what the measured wording
      // already says.
      agent.steer(
        createUserMessage({
          content: [{
            type: 'text',
            text: warn ? wording.continue + wording.continueWarning : wording.continue,
          }],
          source: {
            kind: name,
            form: 'notice',
            // 0.1.7 made the notice bound a published contract
            // (`dsh-llm/lib/types/message.d.ts:109-120`), and the brake summary
            // is the one this package builds from measured counts, so it goes
            // through the bound like every shipped 0.1.7 producer's does.
            summary: boundContextSummary(`${name}: braked ${record.kind} on ${record.channel}`
              + (record.kind === 'announce' ? ` (${record.count} announcements)`
                : record.kind === 'echo' ? ` (${record.count} lines restated)`
                  : ` (${record.count} lines, ${record.span} distinct)`)
              + (warn ? ` [continuations ${state.spentContinues} > ${warnAfterContinues}]` : '')),
          },
        }),
      )
      claim()
      log('continuation steered', state.turnContinues, '/', maxContinues,
        warn ? `(warned, ${state.spentContinues} total)` : '', 'on', record.channel)
      return
      }
    }

    // ---- candidate 2: empty-response recovery (automatic retry) ------------
    if (assistant !== undefined && isEmptyCompletion(assistant.content)) {
      const verdict = retry.decideTurnRecovery(sessionId, 'empty')
      if (verdict.kind === 'retry') {
        if (!await cancellableDelay(verdict.delayMs, signal)) return
        retry.spend(sessionId)
        claim()
        agent.steer(
          createUserMessage({
            content: [{ type: 'text', text: wordingForAgent(session).empty }],
            source: {
              kind: name,
              form: 'notice',
              summary: boundContextSummary(name + ': empty response ('
                + verdict.attempt + '/' + retry.limit + ')'),
            },
          }),
        )
        log('empty-response recovery steered', verdict.attempt, '/', retry.limit)
        return
      }
      log('empty-response recovery declined:', verdict.reason)
    }

    // ---- candidate 3: the turn-completion continuation ---------------------
    //
    // The conditions are `idle-guard`'s, unchanged: per-session budget first,
    // then one nudge per distinct assistant message, then the rule itself. The
    // only edit is that the budget test is in the condition rather than an early
    // `return`, so a turn whose idle budget is spent still reaches the hesitation
    // rule — which is what the two-package layout did.
    if (idleGuard
      && state.idleSteered < idleBudget
      && assistant !== undefined
      && state.idleJudged !== assistant.id
      && isIdleCompletion(assistant.content, minReasoningChars)) {
      state.idleJudged = assistant.id
      state.idleSteered += 1
      claim()
    agent.steer(
      createUserMessage({
        content: [{ type: 'text', text: wordingForAgent(session).idle }],
        source: {
          kind: name,
          form: 'notice',
          summary: `${name}: turn ended on reasoning alone (`
            + state.idleSteered + '/' + idleBudget + ')',
        },
      }),
    )
      log('steered an idle continuation', state.idleSteered, '/', idleBudget)
      return
    }

    // ---- candidate 4: the hesitation nudge ---------------------------------
    // Hesitation is judged here rather than in `preStep` because a turn that
    // completed in one step never reaches another `preStep`: it ends. Steering
    // at this boundary is what buys the nudge a request to ride on, which is the
    // reference's "inject on the next request" semantics.
    if (!hesitationNudge) return
    if (state.spentNudges >= hesitationBudget) return

    // The transcript tail is what the rule reads, and the last assistant message
    // is what it judges. A turn with no assistant message has nothing to judge.
    if (assistant === undefined) return
    const verdict = judgeHesitation(
      assistant.content.map(part => (part.type === 'text' ? part.text : '')).join(''),
    )
    if (verdict === null) return
    // One nudge per distinct transcript: without this the nudge's own turn would
    // be judged and nudged again, which is the 61-request feedback loop the
    // reference hit.
    if (state.judged === assistant.id) return
    state.judged = assistant.id

    state.spentNudges += 1
    log('hesitation nudge', verdict.hits, '/', verdict.lines)
    agent.steer(
      createUserMessage({
        content: [{ type: 'text', text: wordingForAgent(agent.session).hesitation }],
        source: {
          kind: name,
          form: 'notice',
          // Same reasoning as the brake summary: this is the durable evidence, so
          // it carries the measurement that justified the nudge. Bounded for the
          // same reason the brake summary is (`dsh-llm/lib/types/message.d.ts:109-120`).
          summary: boundContextSummary(`${name}: hesitation churn (${verdict.hits}/${verdict.lines} lines, `
            + `share ${verdict.share.toFixed(2)})`),
        },
      }),
    )
  })


  // ---- item 1: bound the logged copy of an oversized job_output ------------
  //
  // Registered on the PTC dispatch log rather than on `tools/post-execute`:
  // post-execute's decision is refolded into the result the model sees, and
  // rewriting that would change the value `run_code` hands back to the calling
  // program. This seam owns only the copy that reaches the transcript
  // (`dsh-tools/lib/index.js:706-714`), so the bound costs the program nothing.
  //
  // The listener never throws. `shapeDispatchLog` contains a thrown listener and
  // logs the original content instead (`:710-713`), so a throw here would
  // silently disable the bound rather than fail the dispatch.
  ctx.on('tools/ptc-dispatch-log', async (dispatch, next) => {
    const content = await next()
    if (!enabled || !jobOutputBound) return content
    const outcome = boundJobOutput(
      {
        exec: {
          callId: dispatch.subCallId,
          ...dispatch.exec.agent === undefined
            ? {}
            : { agent: { id: dispatch.exec.agent.session.id } },
        },
        ...dispatch.agent === undefined ? {} : { agent: dispatch.agent },
        subCallId: dispatch.subCallId,
        name: dispatch.name,
        isError: dispatch.isError,
        content,
      },
      { enabled: true, maxBytes: jobOutputMaxBytes, spillRoot: '' },
    )
    if (!outcome.bounded) return content
    log('job_output bounded:', outcome.totalBytes, '->', outcome.keptBytes, 'bytes;',
      outcome.spillPath ?? '(spill unavailable)')
    return [...outcome.content]
  }, { prepend: true })

  // ---- item 2: the compaction cost ledger ---------------------------------
  //
  // `session/event` is a post-commit observer (`dsh-tool-cordis/lib/types/api-
  // catalog.js:4132-4137`: "callbacks run after it", no return value). That is
  // all this needs: the numbers are already in the committed event, and an
  // observer cannot fail the append it is reading.
  ctx.on('session/event', (session, event: ObservedSessionEvent) => {
    if (!enabled || !costLedger) return
    if (event.type !== 'compaction/summary') return
    const data = (event.data ?? {}) as Record<string, unknown>
    const written = appendLedger(
      { enabled: true, file: costLedgerFile },
      ledgerLine(String(session.id), {
        compactionId: data.compactionId,
        shadowedTokenCount: data.shadowedTokenCount,
        shadowedSeqs: data.shadowedSeqs,
        provider: data.provider,
        model: data.model,
        maxTokens: data.maxTokens,
        usage: data.usage,
      }, new Date()),
    )
    if (!written) log('cost ledger not written; check the path for', costLedgerFile)
  })

  // ---- items 3, 5, 6: one listener on `agent/pre-step` ---------------------
  //
  // One registration for all three, deliberately. The contract says the
  // waterfall's returned value is authoritative
  // (`api-catalog.js:3764-3769`: "Reject a proposed step or replace the messages
  // that enter it"), so two listeners on this seam would each rebuild the array
  // from `next()` and the later one would silently undo the earlier one's edit.
  // Items 3 and 5 therefore have to be the same edit, and item 6 rides along
  // because it is the same rewrite of the same message.
  //
  // `{ prepend: true }` matches the shipped `disposeNotice` listener
  // (`dsh-agent/lib/index.js:204`): ours runs outermost, so the messages it
  // returns are the ones `disposeNotice` then appends to, and neither can
  // discard the other's work.
  ctx.on('agent/pre-step', async ({ messages }, next) => {
    const decision = await next()
    if (decision.kind === 'reject') return decision
    const nextMessages = decision.kind === 'enter' ? decision.messages : messages
    if (!enabled) return decision

    let working = nextMessages

    // item 5 + 6: envelope a settled child's closing message, before the first
    // commit. Only the content changes; `id`, `role`, and `source` are kept
    // verbatim, because the inbox's identity check is on the id
    // (`dsh-agent-loop/lib/index.js:41-45`) and a rewritten source would make
    // the same settlement look like a different event to every consumer.
    if (settleEnvelope) {
      let touched = 0
      working = working.map(message => {
        const replacement = envelopeContent(message, {
          enabled: true,
          headLines: settleEnvelopeHeadLines,
          sections: settleEnvelopeSections,
          gistChars: settleEnvelopeGistChars,
        })
        if (replacement === undefined) return message
        touched += 1
        return { ...message, content: replacement }
      })
      if (touched > 0) log('settle envelope applied to', touched, 'message(s)')
    }

    // item 3: drop only byte-identical repeats of a body from the same producer.
    if (dedupeInjectionsOn) {
      const outcome = dedupeInjections(working, { enabled: true })
      if (outcome.dropped.length > 0) {
        log('dropped', outcome.dropped.length, 'byte-identical repeat injection(s)')
        working = outcome.messages
      }
    }

    if (working === nextMessages) return decision
    return { ...decision, messages: working }
  }, { prepend: true })

  // ---- item 4: a second identical read answers with a pointer --------------
  //
  // Unlike every other bound in this package this one DOES change what the model
  // sees: `dsh-tools` refolds an `accept` decision's content into the result.
  // That is the point — the whole saving is not sending bytes the transcript
  // already carries — and it is why the switch defaults to off.
  //
  // The listener runs `next()` first and only rewrites a successful result: a
  // failed read keeps its error text, because a pointer is not a diagnosis.
  ctx.on('tools/post-execute', async (exec, result, next) => {
    const decision = await next()
    if (!enabled || !suppressRepeatReads) return decision
    if (exec.name !== 'read') return decision
    if (decision.kind !== 'accept') return decision
    if (result.isError) return decision
    const sessionId = exec.agent?.session.id as SessionId | undefined
    if (sessionId === undefined) return decision
    let stamps = readStamps.get(sessionId)
    if (stamps === undefined) {
      stamps = new Map<string, ReadStamp>()
      readStamps.set(sessionId, stamps)
    }
    const verdict = suppressRepeatRead(exec.name, exec.arguments, stamps, { enabled: true })
    if (verdict.record !== undefined) {
      const key = rereadKey(exec.arguments)
      if (key !== undefined) stamps.set(key, verdict.record)
    }
    if (!verdict.suppress || verdict.text === undefined) {
      if (verdict.reason !== undefined) log('repeat-read not suppressed:', verdict.reason)
      return decision
    }
    const target = (exec.arguments as { file_path?: unknown } | null)?.file_path
    log('repeat read answered with a pointer for', typeof target === 'string' ? target : '(unnamed)')
    return { kind: 'accept', content: [{ type: 'text', text: verdict.text }] }
  }, { prepend: true })
}
