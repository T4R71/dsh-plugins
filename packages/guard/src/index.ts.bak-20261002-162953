/** Plugin name, as registered with cordis. */
export const name = 'guard'

/**
 * Services this plugin reads.
 *
 * `llm` supplies the stream hook and the `sessionId` every loop-built request
 * carries; `sessions` is declared because both guards keep per-session budgets
 * and the loop's own session registry is what those ids belong to.
 */
export const inject = ['llm', 'sessions']

/** Which channel a delta belongs to. */
export type Channel = 'text' | 'reasoning'

export interface Config {
  /** Run the guard at all (default `true`). */
  enabled?: boolean
  /**
   * Run the streaming rules — brake, echo, recycling, announcement — at all
   * (default `true`).
   *
   * New with the merge. Both source packages had their own `enabled`; that
   * collapses to one switch when they become one plugin, which would also
   * remove the ability to run one guard without the other. Each guard keeps
   * its own switch here, and both default to the shipped behaviour.
   */
  streamGuard?: boolean
  /**
   * Run the turn-completion rule — a turn that ended on reasoning alone — at
   * all (default `true`).
   *
   * New with the merge; see {@link streamGuard}.
   */
  idleGuard?: boolean
  /**
   * Let the bare filler vocabulary brake the reasoning channel (default `false`).
   *
   * Intent openings always may; this switch governs only the *filler* hits, whose
   * reasoning evidence is weak. The default matters and is inherited from the
   * design this rule replaced, for two measured reasons: reasoning blocks carry
   * replay signatures upstream, and assembly discards the whole replay envelope
   * when the block layout stops matching — so truncating reasoning costs the next
   * request its passback state. A bare `Writing.` in a private trace is also much
   * weaker evidence of collapse than the same word in the answer a person reads.
   *
   * Measured on the live corpus: with this off, 12 reasoning blocks brake on the
   * rule, all of them on intent evidence. Allowing filler as well brakes 20 more,
   * including a 109,217-character block.
   */
  brakeReasoning?: boolean
  /**
  * Longest clause that can still count as an announcement (default `18`).
  *
  * Load-bearing rather than cosmetic: a real planning sentence opens with
  * `Let me` and then keeps going, so measuring only the opening brakes healthy
  * work. Measured, tightening this to 12 loses half of the genuine filler and
  * loosening it to 20 admits 14 samples of real planning.
  */
  announceMax?: number
  /**
  * Non-whitespace characters tolerated between two announcements (default `20`).
  *
  * The reference measured 0 false positives in 7,395 healthy samples at 20; 30
  * produced 1.
  */
  announceGap?: number
  /** Announcements required to prove a stall (default `5`). */
  announceCount?: number
  /**
  * Fraction of the answer's lines that must already be reasoning lines before
  * the echo rule brakes (default `0.9`).
  *
  * Every measured positive scores 1.000 because it copies verbatim, so raising
  * this from 0.8 drops nothing while doubling the margin: the highest healthy
  * streaming prefix observed is 0.714.
  */
  echoMin?: number
  /** Continuations steered per turn (default 2). */
  maxContinues?: number
  /**
   * Continuations after which the prompt starts carrying a warning (default 10).
   *
   * Not a cap: the session is steered indefinitely, because a silent stop is
   * worse for the user than the degeneration it replaced. Crossing this
   * threshold appends {@link Wording.continueWarning} to the continuation so the
   * model learns that resuming has already failed repeatedly.
   */
  warnAfterContinues?: number
  /** Inject a request-side nudge on hesitation churn (default `true`). */
  hesitationNudge?: boolean
  /** Hesitation nudges allowed per session (default 2). */
  hesitationBudget?: number
  /** Emit diagnostics through the logger (default `false`). */
  verbose?: boolean
  /**
   * Continuations steered per session by the turn-completion rule (default
   * `3`).
   *
   * Moved here verbatim from `@t4r71/dsh-idle-guard`: a budget rather than a
   * single shot, because a model that idles once often idles again, and one
   * nudge that is ignored would leave the turn dead. It stays small on
   * purpose — this is a nudge, not a substitute for the model deciding to
   * act, and an unbounded budget would let a pathological session spend
   * forever re-prompting a model that has nothing to do.
   */
  idleBudget?: number
  /**
   * Minimum reasoning length, in characters, before the turn-completion rule
   * considers a turn idle (default `0`).
   *
   * Moved here verbatim from `@t4r71/dsh-idle-guard`: zero by default, because
   * a turn that produced no text and no action is wrong whether the thinking
   * was long or short. Raising it narrows the rule to turns that clearly
   * thought about something and then did not act.
   *
   * Read `isIdleCompletion` before relying on the default: the test is
   * `text === 0 && reasoning >= minReasoningChars`, so at `0` this field is
   * not a threshold at all — it admits every reasoning length, including
   * none. The measured consequence is in
   * `M:/T4/out/guard/E-守卫插件.md`.
   */
  minReasoningChars?: number
  /** Offer the automatic-retry fallback tier (default `true`). */
  retryEnabled?: boolean
  /**
  * Automatic retries and recovery continuations per session (default `3`).
  *
  * One budget for both tiers, deliberately. The number is the one the
  * previous `ds-guard` proxy shipped (`MAX_CONTINUES = 3`), and a single
  * counter is what stops a session whose failure keeps changing shape from
  * spending a fresh allowance each time.
  */
  retryMax?: number
  /**
  * Delay before a fallback retry or a recovery continuation, in ms (default
  * `500`, from the previous `ds-guard` proxy's `CONTINUE_DELAY_MS`).
  */
  retryDelayMs?: number
  /**
  * Failure codes the fallback tier retries (default `['STREAM_CLOSED',
  * 'MALFORMED_RESPONSE', 'PI_AI_ERROR']`).
  *
  * Deliberately *not* the shipped policy's own list. `EMPTY_RESPONSE`,
  * `RATE_LIMIT`, `SERVER`, `TIMEOUT` and `TRANSPORT` are already retried five
  * times by `dsh-llm-retry`; listing them here would describe a second retry
  * of the same failure rather than a gap being filled. Adding one extends
  * that policy's exhausted budget by this tier's `retryMax` — a deliberate
  * choice, not a default.
  *
  * `PI_AI_ERROR` is in the default set because it is the code the pi-ai route
  * raises for a provider error it could not classify
  * (`dsh-llm-pi-ai/lib/index.js:1424`, `:1431`) — the access layer the guard is
  * required to work beside.
  */
  retryCodes?: string[]
  /** Steer a recovery continuation for an assistant message with no blocks (default `true`). */
  retryOnEmpty?: boolean
  /** Steer a recovery continuation for a turn that ended on reasoning alone (default `true`). */
  retryOnDegenerate?: boolean
  /**
   * Append one line to this file every time `apply` runs (default `''`, off).
   *
   * Exists so a deployment can prove the row was actually mounted. 0.1.7's
   * compatibility preflight denies an incompatible row silently at the row level
   * (it writes `dsh: disabling profile plugin …` on stderr and loads nothing), so
   * \"the process started\" is not evidence that this plugin is in it, and a desktop
   * copy's stderr is not always readable. A receipt file is evidence that does not
   * depend on either. Never used by the guard's own logic.
   */
  receiptFile?: string
  /**
   * Bound the logged copy of an oversized `job_output` (default `true`).
   *
   * The defect this closes is in the shipped pair, not here:
   * `dsh-tool-jobs` truncates a `job_output` result only by the producer's
   * `job.outputLimitBytes` (`dsh-tool-jobs/lib/index.js:168`, `:240-255`), and
   * `dsh-tool-pwsh` never sets that field when it registers a job
   * (`dsh-tool-pwsh/lib/index.js:362-390`), so for the jobs this harness runs
   * the bound is absent and every result is unbounded — measured at 438,502
   * characters across 67 sub-dispatches, largest single 49,932.
   *
   * Applied on `tools/ptc-dispatch-log`, which owns exactly the copy that
   * reaches the transcript (`dsh-tools/lib/index.js:706-714`); the value the
   * calling program already received is untouched.
   */
  jobOutputBound?: boolean
  /** Byte cap for {@link Config.jobOutputBound} (default `12000`). */
  jobOutputMaxBytes?: number
  /**
   * Write the compaction cost ledger (default `true`).
   *
   * `dsh-compaction-basic` already records the summarization call's `usage` on
   * its `compaction/summary` event (`lib/index.js:629-649`) and logs only the
   * shadowed token count (`:837`). This writes the numbers that already exist.
   */
  costLedger?: boolean
  /** Ledger file; empty selects the default under the user's temp directory. */
  costLedgerFile?: string
  /**
   * Drop byte-identical repeat injections (default `true`).
   *
   * Only exact duplicates from one producer are dropped, on
   * `agent/pre-step` before the message is ever committed. Measured on this
   * deployment's parent session: `runtime-context` 5 copies of one 2,128-byte
   * body; `time-context` 19 copies with 19 distinct bodies, so none of those
   * are touched.
   */
  dedupeInjections?: boolean
  /**
   * Answer a repeated `read` with a pointer instead of the file (default
   * `false` — the conservative value).
   *
   * Off by default because, unlike every other hook here, it changes what the
   * model receives rather than only what is logged. Turn it on for a session
   * that re-reads the same paths; the pointer names the path, the range, and
   * the flags to re-read with, and is refused outright when the file's size or
   * mtime has changed since the earlier read.
   */
  suppressRepeatReads?: boolean
  /**
   * Replace a settled child's closing message with a recoverable envelope
   * (default `true`).
   *
   * The full closing text is spilled first and the envelope carries its path
   * and `sha256`; if the spill cannot be written the message is left exactly as
   * the harness built it. Measured on this deployment's parent session: 29
   * settlements, 160,237 characters of closing text, largest single 15,562.
   */
  settleEnvelope?: boolean
  /** Section-body lines the envelope shows (default `8`). */
  settleEnvelopeHeadLines?: number
  /**
   * Headings the envelope looks for (default `['结论', '证据', '判不了']`).
   *
   * Narrow it to `['结论']` for a control-plane-only envelope: a parent that
   * decides the next dispatch needs to know what the child concluded, not how it
   * proved it. An empty list means the default, not "no sections".
   */
  settleEnvelopeSections?: string[]
  /**
   * Hard ceiling, in characters, on the envelope's gist body (default `0`, off).
   *
   * `0` keeps the original behaviour exactly: the first `settleEnvelopeHeadLines`
   * lines of each requested section. A positive value replaces that with one
   * excerpt that never exceeds the count — the sections' bodies when the child
   * used a requested heading, and otherwise the opening of its closing message,
   * so the parent can always tell what happened without reading the file. The
   * reminder line says the excerpt is a gist and names the full text.
   */
  settleEnvelopeGistChars?: number
}

