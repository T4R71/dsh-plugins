{
  "name": "@t4r71/dsh-task-tree",
  "description": "The task growing tree bundle: a self-contained package carrying the taskTree host projection, its browser panel drawn as an SVG flow chart, and the patch that inserts both",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T4R71/dsh-plugins.git",
    "directory": "packages/task-tree"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/host.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@t4r71/dsh-task-tree-host": "workspace:^",
    "@t4r71/dsh-ui-task-tree": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
