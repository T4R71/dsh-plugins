{
  // This package builds standalone from node_modules: every `@deepseek-ai/*`
  // import resolves through the package's own dependencies, so this file keeps
  // the compiler options the package needs and declares no `paths`. A repo
  // checkout replaces this with the workspace-wide resolution facade; a
  // published or cloned copy must not depend on one.
  //
  // Byte-for-byte the same compiler options as packages/dual-axis/tsconfig.base.json
  // (the repo's verified 0.1.7-rc.2 package). It replaces the pre-migration
  // config, which extended \`../../../tsconfig.base.json\` and carried project
  // references into \`../../../vendor/*\` and \`../../core/*\` — paths that exist in the
  // 0.1.6-alpha.2 checkout these sources were copied from and nowhere in this repo.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  }
}
