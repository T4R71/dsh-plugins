{
  "name": "@t4r71/dsh-plan-tree",
  "description": "Logged, projected plan tree: plan_write declares the whole tree once, plan_step walks it node by node",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T4R71/dsh-plugins.git",
    "directory": "packages/plan-tree"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
